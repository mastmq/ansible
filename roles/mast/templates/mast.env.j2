{{ ansible_managed | comment }}
#
# Secrets and overrides, read by systemd. Anything under MAST__ overrides
# mast.toml. A header name is upper-cased with hyphens as underscores; the
# broker turns the underscores back into hyphens before sending it.
{% for name, value in mast_auth_http_headers | dictsort %}
MAST__AUTH__HTTP__HEADERS__{{ name | upper | replace('-', '_') }}={{ value | to_json }}
{% endfor %}
{% for name, value in mast_extra_env | dictsort %}
{{ name }}={{ value | string | to_json }}
{% endfor %}
